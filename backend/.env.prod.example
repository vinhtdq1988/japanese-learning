# Cấu hình backend cho môi trường PROD. Sao chép thành .env.prod (script `start-backend.ps1 -Env prod` tự tạo
# và sinh JWT_SECRET ngẫu nhiên nếu thiếu). KHÔNG commit file .env.prod.
# Mọi giá trị còn chứa CHANGE_ME sẽ khiến script từ chối chạy.
# Các biến không liệt kê ở đây (giới hạn tần suất, ngưỡng engine, cấu hình lớp/seat...) dùng giá trị mặc định;
# xem backend/.env.example để biết đầy đủ và chỉ thêm khi cần hiệu chỉnh.

NODE_ENV=production

# --- Kết nối và bí mật ---
# PostgreSQL 16 của production (script KHÔNG tự dựng CSDL ở môi trường này)
DATABASE_URL=postgres://japanese:CHANGE_ME@localhost:5432/japanese_learning
# Khóa ký JWT (HS256), ≥ 32 ký tự ngẫu nhiên; script tự sinh khi tạo file này lần đầu
JWT_SECRET=CHANGE_ME_se-tu-sinh-khi-tao-file
# Máy chủ SMTP thật gửi email đặt lại mật khẩu
SMTP_URL=smtp://CHANGE_ME:CHANGE_ME@smtp.example.com:587
# Địa chỉ gốc công khai của client web (dựng liên kết đặt lại mật khẩu)
APP_BASE_URL=https://CHANGE_ME
PORT=3000
