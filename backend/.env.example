# Sao chép thành `.env` rồi chỉnh giá trị. KHÔNG commit file `.env`.

# --- Kết nối và bí mật ---
# Chuỗi kết nối PostgreSQL 16
DATABASE_URL=postgres://japanese:japanese@localhost:5432/japanese_learning
# Khóa ký JWT (HS256) – PHẢI là chuỗi ngẫu nhiên dài ≥ 32 ký tự; production quản lý qua kho bí mật
JWT_SECRET=doi-gia-tri-nay-thanh-chuoi-ngau-nhien-dai-it-nhat-32-ky-tu
# Máy chủ SMTP gửi email đặt lại mật khẩu (dev: Mailpit, giao diện http://localhost:8025)
SMTP_URL=smtp://localhost:1025
# Địa chỉ gốc của client web, dùng để dựng liên kết đặt lại mật khẩu trong email
APP_BASE_URL=http://localhost:8080
# Cổng lắng nghe của API
PORT=3000

# --- Giới hạn tần suất theo IP (số yêu cầu/phút/IP, R9, FR-040) ---
# Nhóm /trial/* (gồm POST /trial/events) và GET /placement/questions
RATE_LIMIT_TRIAL_PER_MIN=60
# POST /trial/placement/grade
RATE_LIMIT_TRIAL_GRADE_PER_MIN=10
# Đăng ký / đăng nhập / đặt lại mật khẩu (/auth/*)
RATE_LIMIT_AUTH_PER_MIN=10

# --- Ngưỡng engine (cấu hình được để hiệu chỉnh mà không cần phát hành, R6/R7) ---
# Ngưỡng độ chính xác coi là "quá khó" (%) – dưới ngưỡng này liên tiếp 2 phiên thì hạ độ khó
DIFFICULTY_LOW_THRESHOLD_PCT=60
# Ngưỡng độ chính xác coi là "quá dễ" (%) – trên ngưỡng này liên tiếp 2 phiên thì tăng độ khó
DIFFICULTY_HIGH_THRESHOLD_PCT=90
# Số giây ước lượng cho mỗi mục ôn tập, dùng để chia gói ôn theo quỹ thời gian (R7); cũng là quỹ thời
# lượng khi kiểm tra bài Kanji (số bài tập × giây/câu ≤ est_minutes × 60, spec 003)
REVIEW_SECONDS_PER_ITEM=30
# Phông đóng gói cho client, backend đọc bảng cmap để chặn nội dung Kanji thiếu glyph (spec 003).
# Mặc định trỏ tới client/assets/fonts/NotoSansJP.ttf của kho mã (image Docker đã chép sẵn).
# FONT_PATH=
