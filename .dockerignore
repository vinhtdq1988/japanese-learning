# Ngữ cảnh build của backend/Dockerfile là thư mục gốc kho mã: loại bỏ những gì image không cần.
.git
.claude
.specify
specs
# Client không vào image API, trừ phông Noto Sans JP: backend đọc bảng cmap để chặn nội dung Kanji thiếu glyph.
client/*
!client/assets
client/assets/*
!client/assets/fonts
client/assets/fonts/*
!client/assets/fonts/NotoSansJP.ttf
**/node_modules
**/dist
**/coverage
**/*.log
**/.env
**/.env.*
!**/.env.example
certs
