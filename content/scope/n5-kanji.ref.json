  "sources": {
    "s1": {
      "name": "Danh sách chữ Hán JLPT N5 do cộng đồng tổng hợp (ví dụ Tanos JLPT Resources, nhãn JLPT của Jisho)",
      "note": "Chỉ lấy tư cách thành viên danh sách để kiểm chữ Hán trong đoạn đọc/luyện viết (AU15), không chép nghĩa/ví dụ; giấy phép từng nguồn PHẢI được chủ dự án kiểm tra ở cổng G0 (C2)"
    },
    "s2": {
      "name": "Minna no Nihongo Shokyu I (第2版), 3A Corporation",
      "note": "Phạm vi chữ Hán sơ cấp I làm cơ sở xác định chữ thuộc N5; chỉ lấy tư cách thành viên danh sách"
    }
  },
