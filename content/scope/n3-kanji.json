    },
    "s2": {
      "name": "Nihongo So-matome N3 (日本語総まとめ N3 漢字), Asuku",
      "note": "Phạm vi chữ Hán theo giáo trình luyện thi; chỉ lấy tư cách thành viên danh sách"
    }
  },
