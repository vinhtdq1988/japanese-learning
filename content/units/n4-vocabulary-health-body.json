      "examples": [
        {
          "ja": "熱があるので、今日は休みます。",
          "reading": "ねつがあるので、きょうはやすみます。",
          "translation": {
            "vi": "Vì bị sốt nên hôm nay tôi nghỉ.",
            "en": "I have a fever, so I will take today off."
          }
        }
      ]
    },
