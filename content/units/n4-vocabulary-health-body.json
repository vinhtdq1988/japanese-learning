          "translation": {
            "vi": "Tôi bị ngã và bị thương.",
            "en": "I fell and got hurt."
          }
        }
      ]
    },
    {
      "japanese": "風邪",
      "reading": "かぜ",
      "meaning": {
        "vi": "Cảm lạnh",
        "en": "Cold (illness)"
