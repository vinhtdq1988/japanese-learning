    {
      "japanese": "空港",
      "reading": "くうこう",
      "meaning": {
        "vi": "Sân bay",
        "en": "Airport"
      },
      "examples": [
        {
          "ja": "空港までバスで行きます。",
          "reading": "くうこうまでバスでいきます。",
          "translation": {
            "vi": "Tôi đi đến sân bay bằng xe buýt.",
            "en": "I go to the airport by bus."
          }
        }
      ]
    },
    {
      "japanese": "乗り換える",
      "reading": "のりかえる",
      "meaning": {
        "vi": "Đổi tàu, đổi xe",
        "en": "To transfer (trains, buses)"
      },
      "examples": [
        {
          "ja": "新宿で電車を乗り換えます。",
          "reading": "しんじゅくででんしゃをのりかえます。",
          "translation": {
            "vi": "Tôi đổi tàu ở Shinjuku.",
            "en": "I change trains at Shinjuku."
          }
        }
      ]
    },
    {
      "japanese": "交差点",
      "reading": "こうさてん",
      "meaning": {
        "vi": "Ngã tư",
        "en": "Intersection"
      },
      "examples": [
        {
          "ja": "次の交差点を右に曲がってください。",
          "reading": "つぎのこうさてんをみぎにまがってください。",
          "translation": {
            "vi": "Hãy rẽ phải ở ngã tư tiếp theo.",
            "en": "Please turn right at the next intersection."
          }
        }
      ]
    },
    {
      "japanese": "遅れる",
      "reading": "おくれる",
      "meaning": {
        "vi": "Trễ, chậm",
        "en": "To be late, to be delayed"
      },
      "examples": [
        {
          "ja": "電車が遅れました。",
          "reading": "でんしゃがおくれました。",
          "translation": {
            "vi": "Tàu đã bị trễ.",
            "en": "The train was delayed."
          }
        }
      ]
    }
  ],
