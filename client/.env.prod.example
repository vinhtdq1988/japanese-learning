# Cấu hình client web cho môi trường PROD (flutter build web --release). Sao chép thành .env.prod; script tự tạo nếu thiếu.

# Địa chỉ gốc của API. Mặc định /api/v1 = cùng origin, nginx proxy tới backend (xem client/nginx.conf).
# Chỉ đặt URL tuyệt đối khi API ở origin khác (khi đó backend phải bật CORS).
API_BASE_URL=/api/v1
